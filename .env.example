# Listen port (default 3001; auth-service uses 3000, order-service 8080)
PORT=3001
# PostgreSQL connection string. The ?schema= keeps product tables in their own schema.
# Local: postgresql://agriops:<password>@localhost:5432/orders?schema=product
DATABASE_URL=
# Shared JWT settings. Must match auth-service's JWT_SECRET / JWT_ISSUER / JWT_AUDIENCE.
# HS256 needs at least 32 bytes. Generate one with: openssl rand -hex 32
JWT_SECRET=
JWT_ISSUER=auth-service
JWT_AUDIENCE=orders-api
# CORS origin. Local: http://localhost:5173 (default). Render: https://agricultureops.netlify.app
FRONTEND_URL=
